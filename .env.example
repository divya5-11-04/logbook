# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER expose to the browser. Used by the seed script and
# by API routes that need to bypass row-level security for dataset-wide reads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini — server-only, free tier (no credit card required). Used in
# app/api/generate and app/api/growth. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Base URL of the deployed app, used for OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
